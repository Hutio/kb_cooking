filters:
  and:
    - 'note.type == "recipe"'
    - 'note.time_total <= 30'
properties:
  file.name:
    displayName: 요리
  note.cuisine:
    displayName: 계열
  note.category:
    displayName: 분류
  note.time_total:
    displayName: 총 시간(분)
  note.time_active:
    displayName: 손 가는 시간(분)
  note.difficulty:
    displayName: 난이도
views:
  - type: table
    name: 빠른 순
    order:
      - file.name
      - note.cuisine
      - note.category
      - note.time_total
      - note.time_active
      - note.difficulty
    sort:
      - property: note.time_total
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: 계열별
    order:
      - file.name
      - note.category
      - note.time_total
      - note.difficulty
    groupBy:
      property: note.cuisine
      direction: ASC
    sort:
      - property: note.time_total
        direction: ASC
  - type: table
    name: 15분 이내
    filters:
      and:
        - 'note.time_total <= 15'
    order:
      - file.name
      - note.cuisine
      - note.time_total
      - note.difficulty
    sort:
      - property: note.time_total
        direction: ASC
